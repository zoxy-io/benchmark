# python bytecode (report.py imports charts.py)
__pycache__/
*.pyc

# zrk-runner build artifacts (loadgen/zrk-runner/build.sh) — build.zig.zon
# pins the zrk/zio deps, no committed lockfile-equivalent needed beyond that
loadgen/zrk-runner/.zig-cache/
loadgen/zrk-runner/zig-out/
loadgen/zrk-runner/zig-pkg/

# rust build artifacts (proxies/pingora) — Cargo.toml floats on "0.8", no
# committed lockfile on purpose (see its comment)
proxies/pingora/target/
proxies/pingora/Cargo.lock
