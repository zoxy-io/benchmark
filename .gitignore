.env
.env.cloud
results/
cloud/.terraform/
# cloud/.terraform.lock.hcl is COMMITTED on purpose — see cloud/versions.tf
cloud/terraform.tfstate*
cloud/terraform.tfvars
cloud/sa-key.json
.DS_Store

# devenv
.devenv*
devenv.local.nix

# direnv
.direnv

# python bytecode (bench/tools/gate.py)
__pycache__/
*.pyc

# zig build artifacts — build.zig.zon pins the zrk/zio deps, so no committed
# lockfile-equivalent is needed beyond that. zig-pkg/ is a local `--system`
# package dir (vendored copies of the pinned deps), not source.
bench/.zig-cache/
bench/zig-out/
bench/zig-pkg/

# rust build artifacts (proxies/pingora) — Cargo.toml floats on "0.8", no
# committed lockfile on purpose (see its comment)
proxies/pingora/target/
proxies/pingora/Cargo.lock
