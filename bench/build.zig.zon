.{
    .name = .bench,
    .version = "0.0.0",
    // Regenerated for this package (the old zrk_runner fingerprint belongs to
    // loadgen/zrk-runner, which this replaces — reusing it would claim its
    // identity).
    .fingerprint = 0x66d8e325bc180f27,
    .minimum_zig_version = "0.16.0",
    // Bump with `zig fetch --save=zrk git+https://github.com/zoxy-io/zrk#<ref>`.
    // The zio pin MUST match whatever zio commit that zrk ref depends on (check
    // the fetched zrk package's own build.zig.zon), or the `Io` type won't unify
    // across the module boundary — the failure is
    // "file exists in modules 'zio_options' and 'zio_options0'", which reads
    // like a build-system bug rather than the two-copies-of-zio problem it is.
    //
    // No fork left as of zrk v1.4.1 (zoxy-io/zrk#48). zio used to drop a
    // cancel when the io_uring submission queue is full, leaving the target
    // completion stuck `.running` forever and the awaiting task blocked with
    // it — c10k reaches this reliably (10k connections' per-operation
    // timeouts expiring together submit thousands of cancels against a
    // 256-entry ring) and it wedged a nightly run for 115 minutes. Filed as
    // lalinsky/zio#623, fixed upstream in #628 ("flush a full submission
    // queue instead of dropping SQEs", merged as b822fda).
    //
    // That fix is still here: df666c2 is v0.17.0 plus #699, 121 commits ahead
    // of b822fda and zero behind, checked with `compare/b822fda...df666c2`
    // before moving. "The fix is still in there" is exactly the assumption a
    // bump is where you lose.
    //
    // zrk **v2.1.0 and not v2.0.0**: the tag one would reach for predates
    // zoxy-io/zrk#53 and pins BoringSSL, while zoxy pins OpenSSL. The two
    // repositories must agree here — a local band and a fleet number off
    // different generators are not comparable — and zoxy cannot take v2.0.0,
    // because its profile harness links both the zrk and zoxy modules and
    // would get two libcryptos. 2.1.0 is the swap.
    .dependencies = .{
        .zrk = .{
            .url = "git+https://github.com/zoxy-io/zrk?ref=v2.1.0#a47c02d628064dc1d6285fb5d42bdf90ce407b41",
            .hash = "zrk-2.1.0-WqdFO1rQBQA9vPHaywTYs1dBhnCIP_h2Wn06dGSD3uxa",
        },
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio?ref=main#df666c286380bf513dfe843f65a8133207ad7373",
            .hash = "zio-0.17.0-xHbVVJPWJwBY3c_AkOFjUCF_pTIMnMc7ia9ujTjAfsbk",
        },
        .zurl = .{
            .url = "git+https://github.com/zoxy-io/zurl#e6e352b1a809fd56704a06353580d5edff48044c",
            .hash = "zurl-0.0.0--VALCoxDBQDwFYR1ARqp6GwFj-xmKagT9Z8P1CedHTNx",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
