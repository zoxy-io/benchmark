.{
    .name = .bench,
    .version = "0.0.0",
    // Regenerated for this package (the old zrk_runner fingerprint belongs to
    // loadgen/zrk-runner, which this replaces — reusing it would claim its
    // identity).
    .fingerprint = 0x66d8e325bc180f27,
    .minimum_zig_version = "0.16.0",
    // Bump with `zig fetch --save=zrk git+https://github.com/zoxy-io/zrk#<ref>`.
    // The zio pin MUST match whatever zio commit that zrk ref depends on (check
    // the fetched zrk package's own build.zig.zon), or the `Io` type won't unify
    // across the module boundary — the failure is
    // "file exists in modules 'zio_options' and 'zio_options0'", which reads
    // like a build-system bug rather than the two-copies-of-zio problem it is.
    //
    // No fork left as of zrk v1.4.1 (zoxy-io/zrk#48). zio used to drop a
    // cancel when the io_uring submission queue is full, leaving the target
    // completion stuck `.running` forever and the awaiting task blocked with
    // it — c10k reaches this reliably (10k connections' per-operation
    // timeouts expiring together submit thousands of cancels against a
    // 256-entry ring) and it wedged a nightly run for 115 minutes. Filed as
    // lalinsky/zio#623, fixed upstream in #628 ("flush a full submission
    // queue instead of dropping SQEs", merged as b822fda).
    //
    // That fix is still here: 3820667 is 137 commits ahead of b822fda and zero
    // behind, checked with `compare/b822fda...3820667` before moving. "The fix
    // is still in there" is exactly the assumption a bump is where you lose.
    //
    // zrk must stay on a tag that pins OpenSSL rather than BoringSSL (that is
    // zoxy-io/zrk#53 onward, so v2.1.0 or later), because zoxy pins OpenSSL and
    // the two repositories must agree — a local band and a fleet number off
    // different generators are not comparable, and zoxy's profile harness links
    // both the zrk and zoxy modules, so a disagreement is two libcryptos in one
    // binary.
    //
    // zurl is pinned to whatever zrk pins, not bumped independently: zrk's own
    // graph carries it, and two copies would be two incompatible `zurl` types
    // the moment either exposes one across the module boundary.
    .dependencies = .{
        .zrk = .{
            .url = "git+https://github.com/zoxy-io/zrk?ref=v2.2.2#793361a15b98220072ad4a96946047782370eb82",
            .hash = "zrk-2.2.2-WqdFO2RGBgBYo1xIeHULEhviK4TCpmSpAiOwPLshN-l3",
        },
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio?ref=main#38206678edca2abf4e27ce18bb963bfa6f4297ab",
            .hash = "zio-0.17.0-xHbVVK-DKABkbm_XZgK-21SgNvYr9U5zr1MgOw7Q6JtM",
        },
        .zurl = .{
            .url = "git+https://github.com/zoxy-io/zurl#4ecb1768985425d4f09b317f23f203983ef87d96",
            .hash = "zurl-0.0.0--VALCi1dBQA6i4gkVVX11IV13I784dueJYYAzyZZTBPz",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
