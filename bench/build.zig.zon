.{
    .name = .bench,
    .version = "0.0.0",
    // Regenerated for this package (the old zrk_runner fingerprint belongs to
    // loadgen/zrk-runner, which this replaces — reusing it would claim its
    // identity).
    .fingerprint = 0x66d8e325bc180f27,
    .minimum_zig_version = "0.16.0",
    // Bump with `zig fetch --save=zrk git+https://github.com/zoxy-io/zrk#<ref>`.
    // The zio pin MUST match whatever zio commit that zrk ref depends on (check
    // the fetched zrk package's own build.zig.zon), or the `Io` type won't unify
    // across the module boundary — the failure is
    // "file exists in modules 'zio_options' and 'zio_options0'", which reads
    // like a build-system bug rather than the two-copies-of-zio problem it is.
    //
    // zrk is a real RELEASE; only zio is still a fork, for one fix: upstream zio
    // drops a
    // cancel when the io_uring submission queue is full, and the target then
    // never completes, so the awaiting task blocks forever. c10k reaches this
    // reliably — 10k connections whose per-operation timeouts expire together
    // submit thousands of cancels against a 256-entry ring — and it wedged a
    // nightly run for 115 minutes.
    //
    // zio branch fix/cancel-sqe-exhaustion flushes the SQ and retries. That fix
    // is now carried by a real zrk release — v1.4.0 pins this exact zio commit
    // (zoxy-io/zrk#47) — so the temporary zrk fork branch is gone and only the
    // zio pin remains a fork. v1.4.0 also guards three UB/panic paths found in
    // review (#46). Filed upstream as lalinsky/zio#623; when it lands, point zio
    // back at upstream and there is no fork left.
    .dependencies = .{
        .zrk = .{
            .url = "git+https://github.com/zoxy-io/zrk?ref=v1.4.0#77eb138664069f13f816c75411d8bd492294f6d1",
            .hash = "zrk-1.4.0-WqdFO2bBBACjnQy8nf0B08mxoAzb3IeKuwATiWxXecLz",
        },
        .zio = .{
            .url = "git+https://github.com/zoxy-io/zio?ref=fix/cancel-sqe-exhaustion#87db53bdc76c66a95da7dfc5e6ed313b86e2bcbb",
            .hash = "zio-0.16.0-xHbVVD5KJABBZ_JZWYUgHatZ65KMm2uCSto03fyE-GY8",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
