.{
    .name = .bench,
    .version = "0.0.0",
    // Regenerated; the old zrk_runner fingerprint belongs to loadgen/zrk-runner.
    .fingerprint = 0x66d8e325bc180f27,
    .minimum_zig_version = "0.17.1",
    // Bump with `zig fetch --save=zrk git+https://github.com/zoxy-io/zrk#<ref>`,
    // or fetch without `--save` and hand-edit url+hash to keep these comments.
    // The zio pin MUST match the zio that zrk ref depends on (see its
    // build.zig.zon), or `Io` won't unify: "file exists in modules
    // 'zio_options' and 'zio_options0'".
    // zio must include b822fda (lalinsky/zio#628, a dropped-cancel wedge at
    // c10k); check `compare/b822fda...<new>` on every bump.
    // zurl is pinned to whatever zrk pins; two copies would be incompatible.
    .dependencies = .{
        .zrk = .{
            .url = "git+https://github.com/zoxy-io/zrk?ref=v3.0.5#e4c529665a58c340f5020a02730ff66e0ed81e0f",
            .hash = "zrk-3.0.5-WqdFO9knDgCunZPeeD-gPcKnTAfxzv0O1bvJPGB4QDzx",
        },
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio?ref=v0.20.1#c0a6b5877c9bbc71d2d2c0b3374ce7fa61a4ec12",
            .hash = "zio-0.20.1-xHbVVI0wLwDgE2dXWDCWH0UfCQYEhnBYHs1Td12oAGeR",
        },
        .zurl = .{
            .url = "git+https://github.com/zoxy-io/zurl#41a3637f7227f208f503295125e1119f91c9851a",
            .hash = "zurl-0.0.2--VALCsF8BQDs0vOh8b6HYkJHXz0sg6P3sVL34bWgpnD6",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
