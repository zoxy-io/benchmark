{
  "listeners": [{ "bind": "0.0.0.0:@PORT@", "cluster": "origin", "protocol": "http" }],
  "clusters": {
    "origin": { "endpoints": [@BACKEND_ADDRS@], "pick": "rr" }
  },
  "admin": { "bind": "0.0.0.0:9101" },
  "timeouts": {
    "connect_ms": 5000,
    "idle_ms": 60000,
    "drain_deadline_ms": 10000
  },
  "limits": @LIMITS@
}
