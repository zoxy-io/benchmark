# L7 reverse proxy -> backend0..3; TLS server only on TLS profiles (25-tls.sh).
# envsubst template. 1 worker for the 1-CPU quota (`auto` counts host cores).
# backendN resolves once at startup; origins are healthy by then (depends_on).
worker_processes 1;
worker_rlimit_nofile 262144;
error_log /tmp/error.log warn;

events {
    worker_connections 65536;
    use epoll;       # auto-detected on Linux, explicit for documentation
    multi_accept on; # drain the accept queue in one wakeup under bursts
}

http {
    # The official image's stock `main` format, reproduced because this file
    # replaces its nginx.conf. Each proxy logs in its own format.
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    # A file, not stdout: a full stdout pipe blocks the worker on dockerd.
    # /tmp is writable by every proxy image (the image's access.log links to
    # /dev/stdout). Unbuffered, nginx's default: don't tune one proxy's log.
    access_log /tmp/access.log main;
    server_tokens off;

    # Round-robin (nginx default), as on every proxy.
    # `max_fails=0` is required: nginx's default passive health check would
    # eject an origin for 10s on one error past the knee, unlike the others.
    upstream origin {
        server backend0:9000 max_fails=0;
        server backend1:9000 max_fails=0;
        server backend2:9000 max_fails=0;
        server backend3:9000 max_fails=0;

        # Upstream keep-alive pool for parity with the other proxies. Per
        # worker and shared by all four origins, hence 2048 not 512.
        keepalive 2048;
        keepalive_requests 1000000;
        keepalive_timeout 60s;
    }

    server {
        # Port varies per turn (compose.yaml x-proxy-common); rendered by the
        # image's envsubst hook.
        listen ${PROXY_PORT} backlog=65535 reuseport;
        proxy_buffering off;
        include /etc/nginx/origin-location.conf;
    }

    # @TLS_BEGIN@
    # TLS listener. This whole marked block is deleted by 25-tls.sh on a
    # plaintext turn. NO OTHER LINE MAY SPELL EITHER MARKER: sed's range would
    # end early and leave a broken listen directive.
    # Upstream stays plaintext. Same ECDSA P-256 cert for all five proxies.
    server {
        listen ${PROXY_TLS_PORT} ssl backlog=65535 reuseport;
        # TLS 1.3 only, pinned identically across proxies.
        ssl_protocols TLSv1.3;
        ssl_certificate     /etc/bench/tls/bench.crt;
        ssl_certificate_key /etc/bench/tls/bench.key;
        # HTTP/1.1 only (no `http2 on;`), as on every proxy. Session tickets
        # left default; the generator never resumes.
        include /etc/nginx/origin-location.conf;
        proxy_buffering off;
    }
    # @TLS_END@
}
