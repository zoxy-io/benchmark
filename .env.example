# Copy to .env and adjust. Everything has a sane default; the cloud entries are
# written by scripts/zrk-bench.sh from terraform outputs.

# --- the fairness box: identical for every proxy (hard invariant) -----------
# Every proxy is hard-capped to 1 CPU (one thread/process) and pinned to core 0
# by the cloud overlay — the thread knobs are hardcoded to 1 in each proxy's
# config, so there is no PROXY_CPUS knob.
PROXY_MEM=512m
BACKEND_CPUS=4        # >=2x the proxy so the origin is never the bottleneck
BACKEND_MEM=1g

# --- the ramp: identical for every proxy (hard invariant) -------------------
# The load generator is loadgen/zrk (open-loop, coordinated-omission corrected).
# offered == start_rate + slope*t, so elapsed-time maps exactly to offered rate.
# It keeps offering at the scheduled rate past saturation (CO-safe), so the
# tipping point shows as a sharp knee.
MAX_RATE=67000        # req/s at the end of the linear ramp; ~the cross-VM
                      # network ceiling (the direct baseline clean-saturates ~60-65k)
RAMP_SECONDS=300      # ramp length START_RATE -> MAX_RATE (5 min: gentle slope,
                      # less warmup lag, finer per-offered-level resolution)
CONNECTIONS=500       # open connections = in-flight concurrency cap (the open-loop
                      # guard; zrk keeps one request in flight per connection). 500 is
                      # the sweet spot: past every proxy's throughput peak (~200-400
                      # conns) but before the high-concurrency congestion COLLAPSE the
                      # sweep exposed — haproxy/nginx do WORSE at 1024 than here — while
                      # saturating zoxy's ~43k/1-CPU ceiling (~11ms => ~470 conns,
                      # Little's law), well under its conn_slots default (1386 on the
                      # #61+ build; older builds capped ~1020 and churned at/over it).
TIMEOUT_S=1           # per-request WIRE timeout (bytes-out -> bytes-in). A hung-
                      # connection guard, NOT a CO-tail bound: past saturation a
                      # request waits for a free connection but completes fast once
                      # it has one, so it never trips the timeout while its
                      # scheduled->response latency balloons. Latency fairness is a
                      # REPORT concern — p50/p99 are read at a common sub-knee
                      # reference rate (report REF_RATE, default 2000 rps); overload
                      # shows as achieved-shortfall (shed), not errors.
REQ_PATH=/1k          # /64 /1k /10k /100k

# --- run driver --------------------------------------------------------------
PROXIES="direct zoxy haproxy envoy traefik nginx pingora"   # L7 HTTP reverse proxies
                                             # (zoxy phase-1 adds an `http`
                                             # listener); zoxy needs a Linux
                                             # docker host with io_uring (native
                                             # arch is fine — no emulation).
                                             # pingora is a Rust binary we build
                                             # on the Pingora framework
                                             # (proxies/pingora)
COOLDOWN=8            # seconds between proxies (settle + scrape)
# zrk itself is no longer fetched here: loadgen/zrk-runner embeds zrk's own
# runner.run as a library (see its README's "Library usage") instead of
# spawning the zrk CLI and tailing its output, so the zrk/zio versions used
# are pinned in loadgen/zrk-runner/build.zig.zon (bump with `zig fetch
# --save=zrk git+https://github.com/zoxy-io/zrk#<ref>`; the zio pin must
# match whatever zio commit that zrk ref itself depends on, or the Io type
# won't unify across the module boundary — check the fetched zrk package's
# own build.zig.zon for its zio dependency, then `zig fetch --save=zio` that
# exact commit). Currently pinned to v1.3.1 (zio bumped to lalinsky/zio main
# 3566a3a), which fixes zoxy-io/zrk#42: under sustained overload at high
# connection counts a run would stop producing --timeseries rows while the
# process stayed alive and kept serving — a cross-thread clearTimer racing a
# firing timer in zio's event loop (watchTimer's io.sleep+cancel path, ~20k/s
# under load). Root-caused via our own c10k validation runs hanging mid-ramp
# with zoxy itself confirmed healthy throughout. v1.2.2 fixed an earlier,
# different silent-truncation bug (#39: a canceled run or failed --timeseries
# write used to be swallowed and reported as a normal, complete result).
# Calling runner.run in-process means a bad run surfaces as a real exit code
# (zrk-bench.sh warns on nonzero), not something a subprocess pipe could
# swallow.

# --- zoxy build ---------------------------------------------------------------
ZOXY_REF=1735ed7a7c2ea22e8786a83ec8309cdd80760484  # pinned SHA of zoxy-io/zoxy
                      # main tip as of 2026-07-28 (one commit past 534152f).
                      # #109 adds timeouts.request_ms (config.template.json
                      # sets it to 200): a cap on one L7 exchange, from the
                      # request head being routed to the last response byte —
                      # NOT refreshed by activity like idle_ms, so it bounds a
                      # request that's merely slow, not only one that has
                      # stalled. 0 (the default) disables it. Direct fallout
                      # from our own #108 c10k run: pinning the upstream
                      # ceiling to the conn ceiling drove shedding to ~0 but
                      # left nothing bounding an overloaded exchange at all —
                      # zoxy's own before/after (22,568->0 sheds, throughput
                      # flat) showed connection churn tripling and 140,947
                      # served-but-abandoned responses (loadgen had already
                      # timed out and moved on). Expires into a 504 with no
                      # body sent, or a teardown if a response was already in
                      # flight. Smoke-tested locally (config parses, zoxy
                      # starts and serves 200s; conn-slot footprint ticked up
                      # 8B/slot for the new per-connection deadline field —
                      # 290,899->290,988 KiB at conn_slots=upstream_slots=
                      # 11464) against this repo's config.template.json/
                      # entrypoint.sh before use. #108 (prior pin) pinned the
                      # upstream-pool ceiling to the conn-slot ceiling — both
                      # now 11464 (was 12282/8192) — because an upstream is
                      # leased for a whole client exchange, not per in-flight
                      # request, so a conn_slots_max above upstream_slots_max
                      # was admission capacity that couldn't be served. Pin a
                      # SHA — the Dockerfile caches the git clone, so a branch
                      # name like "main" would silently be a stale commit.
#ZOXY_CONN_SLOTS=     # OPTIONAL: config.json's limits.conn_slots (default 1386,
                      # ~32 MiB, when unset — the entrypoint renders `{}`, byte-
                      # identical to omitting the key). Raise toward the comptime
                      # c10k ceiling (11464 by default) to test past 1386; pair
                      # with a much higher CONNECTIONS or this does nothing
                      # (zoxy just has more headroom it never needs).
#ZOXY_UPSTREAM_SLOTS= # OPTIONAL: config.json's limits.upstream_slots (default
                      # 1024 when unset). Raise toward the comptime ceiling
                      # (11464 by default, same as ZOXY_CONN_SLOTS as of #108 —
                      # a conn without a leased upstream can't be served, so
                      # the two ceilings are now pinned equal) for a c10k-scale
                      # run: zoxy's own numbers, at 10k connections 1024 pins
                      # and sheds ~1/3 of responses.
#RELAY_BUFFERS_MAX=   # OPTIONAL, L4-LEGACY: override of zoxy's per-process L4
                      # relay-buffer cap. Does NOT apply to the phase-1 L7 path
                      # (bounded by conn_slots_max, default ceiling 11464, plus
                      # the upstream pool), and the build-time sed fails loudly
                      # against a phase-1 ref because the decl is no longer a
                      # numeric literal. Leave empty for L7 runs.
#UPSTREAM_SLOTS_MAX=  # OPTIONAL: build-time override of the comptime upstream-
#CONN_SLOTS_MAX=      # pool ceiling and its paired conn_slots_max — both now
                      # 11464 by default (zoxy #108 pins them equal) and both
                      # compile-time literals, comptime-asserted self-consistent
                      # (same shared io_uring completion-queue budget). This is
                      # for pushing PAST the compiled default ceiling, not
                      # reaching it — use ZOXY_UPSTREAM_SLOTS/ZOXY_CONN_SLOTS
                      # (runtime, no rebuild) for that. Set both together or the
                      # build fails loudly. Leave both empty for the compiled
                      # default (11464/11464).
#HEAD_BYTES_MAX_KIB=  # OPTIONAL: build-time override of zoxy's max L7 request/
                      # response head, in KiB (default 8; comptime floor 1).
                      # Shrinks the per-conn/upstream-slot memory footprint -
                      # a head over the new bound gets 414/431/torn down
                      # instead of served, fine for this bench's small headers,
                      # not a safe default for arbitrary traffic. Leave empty
                      # for the compiled default (8 KiB).

# --- cloud only (filled by scripts/zrk-bench.sh) ------------------------------
#PROM_TARGETS=cloud
#BACKEND_IP=10.10.0.6
#PROXY_IP=10.10.0.34
