{
  "uid": "proxy-bench-live-zrk",
  "title": "Proxy bench — live run (zrk open-loop)",
  "description": "Watch a ramp as it runs. Cross-proxy comparison lives in the HTML report (make report), not here.",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(zrk_achieved_rps, testid)",
        "refresh": 2,
        "sort": 4
      },
      {
        "name": "proxy",
        "label": "proxy",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(zrk_achieved_rps{testid=~\"$testid\"}, proxy)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests/s: offered vs. completed (ok + failed stacked)",
      "description": "The stacked area is every attempt that actually finished (ok or failed) this second; the dashed line is what the ramp was asking for. A gap between the line and the top of the stack is backlog building (requests not yet attempted), not the same thing as the red failed slice — those DID reach the wire and got a non-2xx/3xx, a socket error, or a timeout.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal",
              "group": "reqs"
            }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "C" },
            "properties": [
              { "id": "custom.stacking", "value": { "mode": "none", "group": "reqs" } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "custom.lineWidth", "value": 2 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "grey" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (proxy) (zrk_achieved_rps{testid=~\"$testid\", proxy=~\"$proxy\"})",
          "legendFormat": "{{proxy}} ok"
        },
        {
          "refId": "B",
          "expr": "sum by (proxy) (zrk_failed_rps{testid=~\"$testid\", proxy=~\"$proxy\"})",
          "legendFormat": "{{proxy}} failed"
        },
        {
          "refId": "C",
          "expr": "sum by (proxy) (zrk_offered_rps{testid=~\"$testid\", proxy=~\"$proxy\"})",
          "legendFormat": "{{proxy}} offered (target)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency (p50 / p90 / p99 / p99.9)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (proxy) (zrk_latency_seconds{testid=~\"$testid\", proxy=~\"$proxy\", quantile=\"0.5\"})",
          "legendFormat": "{{proxy}} p50"
        },
        {
          "refId": "B",
          "expr": "max by (proxy) (zrk_latency_seconds{testid=~\"$testid\", proxy=~\"$proxy\", quantile=\"0.9\"})",
          "legendFormat": "{{proxy}} p90"
        },
        {
          "refId": "C",
          "expr": "max by (proxy) (zrk_latency_seconds{testid=~\"$testid\", proxy=~\"$proxy\", quantile=\"0.99\"})",
          "legendFormat": "{{proxy}} p99"
        },
        {
          "refId": "D",
          "expr": "max by (proxy) (zrk_latency_seconds{testid=~\"$testid\", proxy=~\"$proxy\", quantile=\"0.999\"})",
          "legendFormat": "{{proxy}} p99.9"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error ratio (failed / attempted)",
      "description": "Share of this second's completed attempts that failed (non-2xx/3xx, socket error, or timeout). Zero during clean shedding — a proxy that falls behind but never errors shows up in the shortfall panel, not here.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (proxy) (zrk_errors_ratio{testid=~\"$testid\", proxy=~\"$proxy\"})",
          "legendFormat": "{{proxy}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Offered shortfall (backlogged, not yet attempted)",
      "description": "offered - ok - failed: requests the ramp asked for that haven't reached the wire yet this second (queued behind a slower server). Distinct from \"failed\" above, which already made an attempt.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (proxy) (zrk_offered_rps{testid=~\"$testid\", proxy=~\"$proxy\"} - zrk_achieved_rps{testid=~\"$testid\", proxy=~\"$proxy\"} - zrk_failed_rps{testid=~\"$testid\", proxy=~\"$proxy\"})",
          "legendFormat": "{{proxy}} shortfall"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Proxy container CPU (cores)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"zoxy|haproxy|envoy|traefik|nginx|pingora\"}[15s]))",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Proxy container memory (working set)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (name) (last_over_time(container_memory_working_set_bytes{name=~\"zoxy|haproxy|envoy|traefik|nginx|pingora\"}[15s]))",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Host CPU busy % by role (excl. iowait; validity: loadgen/backend must have headroom)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (role) (rate(node_cpu_seconds_total{mode=~\"idle|iowait\"}[30s])))",
          "legendFormat": "{{role}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "zoxy — request throughput (its own counters)",
      "description": "L7 responses/s and completed/s are request-level; see the connection panel for accept rate (a different unit of work — one connection can carry many requests).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(zoxy_l7_responses[30s])",
          "legendFormat": "L7 responses/s"
        },
        {
          "refId": "B",
          "expr": "rate(zoxy_completed[30s])",
          "legendFormat": "completed/s"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "zoxy — connection accept rate",
      "description": "Connections/s, not requests/s — kept off the request-throughput panel above so the two units of work aren't overlaid on one axis.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(zoxy_accepted[30s])",
          "legendFormat": "accepted conns/s"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "zoxy — admission shedding (flat 0 = no conn-slot pressure; spikes = at the cap)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(zoxy_shed_conn_slots[30s])",
          "legendFormat": "shed conn_slots/s"
        },
        {
          "refId": "B",
          "expr": "rate(zoxy_shed_relay_buffers[30s])",
          "legendFormat": "shed relay_buffers/s"
        },
        {
          "refId": "C",
          "expr": "rate(zoxy_shed_draining[30s])",
          "legendFormat": "shed draining/s"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "semi-dark-orange",
        "name": "Proxy pass",
        "expr": "sum(zrk_achieved_rps{testid=~\"$testid\"}) by (proxy)",
        "step": "15s",
        "tagKeys": "proxy",
        "titleFormat": "{{proxy}}",
        "textFormat": "{{proxy}} pass",
        "useValueForTime": false
      }
    ]
  }
}
