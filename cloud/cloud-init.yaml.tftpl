#cloud-config
# One template for every host, switched on ${role}: everything outside the
# loadgen tail must be identical on all hosts, or we measure hosts, not proxies.
#
# templatefile() input: a shell `$${...}` needs a doubled dollar.

users:
  - name: ubuntu
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${ssh_public_key}

# Host keys come from terraform, so the loadgen's known_hosts is correct before
# peers boot (strict checking, no TOFU). ed25519 only.
ssh_keys:
  ed25519_private: |
    ${indent(4, ssh_host_private_key)}
  ed25519_public: ${ssh_host_public_key}
ssh_genkeytypes: [ed25519]

write_files:
  # overlay2 graphdriver: under the containerd image store cAdvisor loses
  # per-container metrics.
  - path: /etc/docker/daemon.json
    content: |
      { "features": { "containerd-snapshotter": false } }

  # Without these the kernel caps the proxy and the loadgen's ephemeral ports.
  - path: /etc/sysctl.d/99-bench.conf
    content: |
      net.core.somaxconn = 65535
      net.core.netdev_max_backlog = 65536
      net.ipv4.tcp_max_syn_backlog = 65536
      net.ipv4.ip_local_port_range = 1024 65535
      # Every port a listener binds must be excluded from that range, or the
      # kernel hands it to an upstream connection as a source port and the next
      # turn's bind fails with EADDRINUSE (run #40: zoxy on 18104/18128, envoy
      # on 18140). SO_REUSEADDR/SO_REUSEPORT do not help: the squatter is an
      # ordinary outbound socket that set neither. Reservation only removes
      # them from *automatic* allocation; an explicit bind still works.
      #   8080-8081  local proxy port, cAdvisor
      #   9000       backend
      #   9101,9902  zoxy and envoy admin
      #   18080-19199 suite.zig's per-turn plaintext and TLS pools, with room
      #               for the profiles proxyPort has yet to number
      net.ipv4.ip_local_reserved_ports = 8080-8081,8443,9000,9101,9902,18080-19199
      net.ipv4.tcp_tw_reuse = 1
      fs.file-max = 2097152
      fs.nr_open = 2097152

  # fd limits for c10k. pam_limits covers login sessions only; systemd units
  # ignore it, hence LimitNOFILE/LimitMEMLOCK in bench-suite.service.
  - path: /etc/security/limits.d/99-bench.conf
    content: |
      ubuntu soft nofile 1048576
      ubuntu hard nofile 1048576
      ubuntu soft memlock unlimited
      ubuntu hard memlock unlimited

  # needrestart restarts docker mid-run after package_update (killed run #15).
  # `l` = list only; the fleet is torn down after the run anyway.
  - path: /etc/needrestart/conf.d/99-bench.conf
    content: |
      $nrconf{restart} = 'l';
      $nrconf{kernelhints} = 0;

  # VM-side contract env for the scripts and the unit. Nothing secret.
  - path: /etc/bench/env
    content: |
      BENCH_BUCKET=${bench_bucket}
      BENCH_RUNID=${runid}
      BENCH_PROFILES=${bench_profiles}
      BENCH_PROXIES=${bench_proxies}
      PROXY_IP=${proxy_ip}
      # Comma-separated and ordered: entry n is backendN.
      BACKEND_IPS=${backend_ips}
      SSH_KEY=${ssh_key_path}
      BENCH_ROLE=${role}
      # Not in the contract: remote.Ssh passes UserKnownHostsFile explicitly.
      BENCH_KNOWN_HOSTS=/home/ubuntu/.ssh/known_hosts

  # Object Storage via a metadata-service IAM token, so no key on the VM.
  # Tokens are short-lived: every call mints a fresh one.
  - path: /usr/local/bin/bench-os
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      set -a; . /etc/bench/env; set +a
      bucket="https://storage.yandexcloud.net/$BENCH_BUCKET"
      # Run artifacts are namespaced by RUNID; the `-shared` verbs are not.
      base="$bucket/runs/$BENCH_RUNID"
      tok=$(curl -sfS -H 'Metadata-Flavor: Google' \
        http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token \
        | python3 -c 'import json,sys; print(json.load(sys.stdin)["access_token"])')
      case "$1" in
        get) curl -sfS -H "Authorization: Bearer $tok" -o "$3" "$base/$2" ;;
        put) curl -sfS -X PUT -H "Authorization: Bearer $tok" --data-binary "@$3" "$base/$2" ;;
        say) printf '%s\n' "$3" | curl -sfS -X PUT -H "Authorization: Bearer $tok" --data-binary @- "$base/$2" ;;
        # Bucket root, for objects that must outlive the run (image cache):
        # nothing reads another run's runs/<runid>/ prefix.
        get-shared) curl -sfS -H "Authorization: Bearer $tok" -o "$3" "$bucket/$2" ;;
        put-shared) curl -sfS -X PUT -H "Authorization: Bearer $tok" --data-binary "@$3" "$bucket/$2" ;;
        *)   echo "usage: bench-os get|put|say|get-shared|put-shared <object> <file|text>" >&2; exit 2 ;;
      esac

  # Restore/save deterministic proxy images via Object Storage. pingora (fully
  # pinned, ~470s build) is cached; zoxy tracks floating main and is not.
  # The key must hash every build input plus the CPU model (native builds), or
  # a stale image gets benchmarked silently. Watch the suite log for "restored"
  # vs "built in" when changing this.
  - path: /usr/local/bin/bench-image-cache
    permissions: "0755"
    content: |
      #!/bin/bash
      set -uo pipefail
      set -a; . /etc/bench/env; set +a

      op=$${1:?usage: bench-image-cache restore|save <name> <image-tag>}
      name=$${2:?}
      tag=$${3:?}
      ctx="/home/ubuntu/bench/proxies/$name"
      [ -d "$ctx" ] || exit 1

      # every build input, plus this host's CPU model
      key=$( { find "$ctx" -type f -print0 | sort -z | xargs -0 cat;
               grep -m1 '^model name' /proc/cpuinfo; } \
             | sha256sum | cut -c1-16 )
      obj="cache/$name-$key.tar"

      # -shared: RUNID-namespaced objects are invisible to other runs.
      case "$op" in
        restore)
          bench-os get-shared "$obj" /tmp/$name-cache.tar >/dev/null 2>&1 \
            || { echo "image cache: miss $name ($key)" >&2; exit 1; }
          docker load -i /tmp/$name-cache.tar >/dev/null 2>&1 \
            || { echo "image cache: unreadable $name ($key)" >&2; exit 1; }
          docker image inspect "$tag" >/dev/null 2>&1 \
            || { echo "image cache: $obj carries no $tag" >&2; exit 1; }
          echo "image cache: restored $name ($key)"
          ;;
        save)
          docker save "$tag" -o /tmp/$name-cache.tar 2>/dev/null \
            || { echo "image cache: nothing tagged $tag to save" >&2; exit 0; }
          bench-os put-shared "$obj" /tmp/$name-cache.tar >/dev/null 2>&1 \
            && echo "image cache: saved $name ($key)" \
            || echo "image cache: upload failed for $obj" >&2
          rm -f /tmp/$name-cache.tar
          ;;
        *) exit 2 ;;
      esac

  # payload.tar is uploaded before apply; the retry covers the NAT route and
  # SA binding becoming usable a few seconds after boot.
  - path: /usr/local/bin/bench-payload
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      install -d -o ubuntu -g ubuntu /home/ubuntu/bench
      for _ in $(seq 1 60); do
        if bench-os get payload.tar /tmp/payload.tar; then break; fi
        sleep 5
      done
      test -s /tmp/payload.tar
      tar -xf /tmp/payload.tar -C /home/ubuntu/bench
      chown -R ubuntu:ubuntu /home/ubuntu/bench
%{~ if role == "loadgen" }

  # Per-run ssh identity; exists only here and in CI's terraform state.
  # defer: `owner: ubuntu` needs the users module to have run.
  - path: ${ssh_key_path}
    owner: "ubuntu:ubuntu"
    permissions: "0600"
    defer: true
    content: |
      ${indent(6, fleet_private_key)}

  # Default location, so any ssh invocation verifies peers without flags.
  - path: /home/ubuntu/.ssh/known_hosts
    owner: "ubuntu:ubuntu"
    permissions: "0644"
    defer: true
    content: |
      ${indent(6, known_hosts)}

  # The run end to end. results.tar goes up before DONE, so the runner never
  # fetches a half-uploaded object.
  - path: /usr/local/bin/bench-drive
    permissions: "0755"
    content: |
      #!/bin/bash
      set -uo pipefail
      set -a; . /etc/bench/env; set +a

      LOG=/home/ubuntu/bench.log
      # Written on every terminal path; bench-postmortem speaks only if absent.
      # Under $HOME: /run is root-owned and the unit runs as ubuntu.
      TERMINAL=/home/ubuntu/.bench-terminal
      exec > >(tee -a "$LOG") 2>&1

      fail() {
        echo "FAILED: $*"
        bench-os put log "$LOG" || true
        bench-os say FAILED "$*" || true
        : > "$TERMINAL" || true
        exit 1
      }

      # after fail(), so a missing payload reports FAILED
      cd /home/ubuntu/bench || fail "payload never unpacked into ~/bench"

      # same pinning as remote.Ssh: host keys come from terraform
      peer() {
        timeout 900 ssh -i "$SSH_KEY" \
          -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=5 \
          -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$BENCH_KNOWN_HOSTS" \
          "ubuntu@$1" "$2"
      }

      # sshd is up long before docker and the payload. `cloud-init status
      # --wait` exits 2 on mere warnings, so its status is ignored.
      wait_peer() {
        for _ in $(seq 1 120); do
          if peer "$1" 'cloud-init status --wait >/dev/null 2>&1; test -d ~/bench && docker info >/dev/null 2>&1'; then
            return 0
          fi
          sleep 10
        done
        return 1
      }

      wait_peer "$PROXY_IP" || fail "proxy never became ready"
      # All-or-nothing: a booting backend doesn't fail the run, it fakes a proxy
      # regression. `tr`, not a subshell IFS, so fail() exits the script. Log
      # the index, never the address (bench/CONTRACT.md, redact.assertNoIps).
      i=0
      for ip in $(echo "$BACKEND_IPS" | tr ',' ' '); do
        wait_peer "$ip" || fail "backend #$i never became ready"
        i=$((i + 1))
      done

      # the contract's `log`, re-uploaded every ~30s for the runner to stream
      ( while sleep 30; do bench-os put log "$LOG" || true; done ) &
      tailer=$!
      trap 'kill $tailer 2>/dev/null || true' EXIT

      rc=0
      IFS=, read -r -a profiles <<< "$BENCH_PROFILES"
      for p in "$${profiles[@]}"; do
        ./bench suite --profile "$p" --proxies "$BENCH_PROXIES" || rc=$?
        # Upload the cumulative results after EVERY profile, even a failed one,
        # so a later hang cannot discard finished profiles.
        if [ -n "$(find results/"$BENCH_RUNID" -type f -print -quit 2>/dev/null)" ]; then
          tar -cf /tmp/results.tar -C results "$BENCH_RUNID" \
            && bench-os put results.tar /tmp/results.tar \
            || echo "warning: interim results.tar upload failed after $p" >&2
        fi
      done

      # tar succeeds on an empty tree; fail here, not as a confusing
      # FileNotFound in the report.
      if [ -z "$(find results/"$BENCH_RUNID" -type f -print -quit 2>/dev/null)" ]; then
        fail "suite produced no artifacts (rc=$rc)"
      fi

      tar -cf /tmp/results.tar -C results "$BENCH_RUNID" || fail "suite produced no results/$BENCH_RUNID"
      bench-os put results.tar /tmp/results.tar || fail "results.tar upload failed"
      kill $tailer 2>/dev/null || true
      bench-os put log "$LOG" || true
      # rc 3: some proxy failed; rc 4: the watchdog (suite.zig ProxyWatchdog)
      # ended a wedged run. Both still carry valid per-proxy records, so they
      # report DONE (see run 20260730-112927). Anything else is FAILED.
      if [ "$rc" -eq 0 ] || [ "$rc" -eq 3 ] || [ "$rc" -eq 4 ]; then
        bench-os say DONE "rc=$rc"
        : > "$TERMINAL" || true
      else
        bench-os say FAILED "suite exited $rc"
        : > "$TERMINAL" || true
      fi
      exit $rc

  # ExecStopPost: reports FAILED only if bench-drive died without writing
  # $TERMINAL, e.g. when OOM-killed (otherwise `bench wait` polls until
  # timeout). Needs root for dmesg.
  - path: /usr/local/bin/bench-postmortem
    permissions: "0755"
    content: |
      #!/bin/bash
      set -uo pipefail
      set -a; . /etc/bench/env; set +a

      TERMINAL=/home/ubuntu/.bench-terminal
      LOG=/home/ubuntu/bench.log
      [ -e "$TERMINAL" ] && exit 0

      {
        echo
        echo "=== bench-drive died without writing a terminal marker ==="
        echo "SERVICE_RESULT=$${SERVICE_RESULT:-?} EXIT_CODE=$${EXIT_CODE:-?} EXIT_STATUS=$${EXIT_STATUS:-?}"
        echo "--- memory at death ---"
        free -m 2>/dev/null
        echo "--- kernel OOM verdicts ---"
        dmesg 2>/dev/null | grep -iE "out of memory|oom-kill|killed process" | tail -5
        echo "--- unit journal, last 40 ---"
        journalctl -u bench-suite.service --no-pager -n 40 2>/dev/null
      } >> "$LOG" 2>&1

      bench-os put log "$LOG" || true
      bench-os say FAILED "bench-drive died: $${SERVICE_RESULT:-unknown} $${EXIT_STATUS:-}" || true
      : > "$TERMINAL" || true

  - path: /etc/systemd/system/bench-suite.service
    content: |
      [Unit]
      Description=zoxy-benchmark self-driving suite
      # Wants, not Requires: Requires turns a docker restart into a SIGTERM
      # the suite cannot report (run #15).
      Wants=docker.service network-online.target
      After=docker.service network-online.target

      [Service]
      Type=oneshot
      User=ubuntu
      Group=ubuntu
      WorkingDirectory=/home/ubuntu/bench
      EnvironmentFile=/etc/bench/env
      ExecStart=/usr/local/bin/bench-drive
      # `+` = root, for dmesg. No-op unless bench-drive died without reporting.
      ExecStopPost=+/usr/local/bin/bench-postmortem
      # A unit bypasses pam_limits; without these c10k hits the 1024 default.
      LimitNOFILE=1048576
      LimitMEMLOCK=infinity
      TimeoutStartSec=infinity
%{~ endif }

# Mask background apt in bootcmd; runcmd is too late for its Persistent timers.
# An openssh-server upgrade restarts ssh and refuses connections mid-run (run
# 32885230435). `--now` also stops timers that already fired.
bootcmd:
  - systemctl mask --now unattended-upgrades.service apt-daily.timer apt-daily.service apt-daily-upgrade.timer apt-daily-upgrade.service || true

apt:
  sources:
    docker:
      source: "deb [signed-by=$KEY_FILE] https://download.docker.com/linux/ubuntu $RELEASE stable"
      keyid: 9DC858229FC7DD38854AE2D88D81803C0EBFCD88

package_update: true

runcmd:
  - sysctl --system
  # Pin docker-ce to var.docker_version; the other packages to whatever is
  # newest at boot, so at least fixed for this VM's life.
  - >-
    VERSION=$(apt-cache madison docker-ce | awk '$3 ~ /${docker_version}/ {print $3; exit}');
    CONTAINERD_VERSION=$(apt-cache madison containerd.io | awk 'NR==1{print $3}');
    BUILDX_VERSION=$(apt-cache madison docker-buildx-plugin | awk 'NR==1{print $3}');
    COMPOSE_VERSION=$(apt-cache madison docker-compose-plugin | awk 'NR==1{print $3}');
    apt-get install -y docker-ce=$VERSION docker-ce-cli=$VERSION
    containerd.io=$CONTAINERD_VERSION docker-buildx-plugin=$BUILDX_VERSION
    docker-compose-plugin=$COMPOSE_VERSION
  - apt-mark hold docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - systemctl enable --now docker
  - /usr/local/bin/bench-payload
  # One boot-ok object per role (ycs.Keys.bootOk), so a missing one names the
  # host that failed.
  - bench-os say boot-ok.${role} "${role} ready"
%{~ if role == "loadgen" }
  # a root-owned ~/.ssh breaks ssh an hour later, mid-ramp
  - chown -R ubuntu:ubuntu /home/ubuntu/.ssh
  - chmod 700 /home/ubuntu/.ssh
  # --no-block: the suite runs ~1h; cloud-init must report done long before.
  - systemctl daemon-reload
  - systemctl start --no-block bench-suite.service
%{~ endif }
