#cloud-config
# ONE template for all three roles, switched on ${role}. Everything above the
# switch — the docker pin, the sysctls, the fd limits, the payload — has to be
# provably identical on loadgen/proxy/backend, or the benchmark is measuring
# hosts instead of proxies. Keeping it in a single file is how that stays true
# under editing; three templates would drift the first time someone fixed a bug
# in two of them. Only the tail differs, behind one `if role == "loadgen"`.
#
# NOTE: this file is templatefile() input, so every `$${...}` a shell would
# expand has to be written with a doubled dollar. Bare `$VAR` is untouched.

users:
  - name: ubuntu
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${ssh_public_key}

# Host keys come from terraform instead of first boot, so the loadgen's
# known_hosts is already correct before its peers have finished booting and it
# can drive them with ssh's default StrictHostKeyChecking rather than accepting
# whatever answers on :22. Only ed25519 is generated, so there is exactly one
# key a peer can offer and no algorithm negotiation to reason about.
ssh_keys:
  ed25519_private: |
    ${indent(4, ssh_host_private_key)}
  ed25519_public: ${ssh_host_public_key}
ssh_genkeytypes: [ed25519]

write_files:
  # Classic overlay2 graphdriver: cAdvisor's docker handler cannot resolve
  # container rw-layers under the containerd image store (no per-container
  # cpu/mem metrics). write_files runs before runcmd, so the daemon reads
  # this on first start.
  - path: /etc/docker/daemon.json
    content: |
      { "features": { "containerd-snapshotter": false } }

  # v1's tuning list, ported: without these the kernel caps a fast proxy (and
  # the loadgen's ephemeral ports) far below the hardware ceiling.
  - path: /etc/sysctl.d/99-bench.conf
    content: |
      net.core.somaxconn = 65535
      net.core.netdev_max_backlog = 65536
      net.ipv4.tcp_max_syn_backlog = 65536
      net.ipv4.ip_local_port_range = 1024 65535
      net.ipv4.tcp_tw_reuse = 1
      fs.file-max = 2097152
      fs.nr_open = 2097152

  # The c10k profile wants ~10k sockets on the loadgen and two per connection on
  # the proxy. `ulimit -n` in a script can only ever LOWER the hard limit, so
  # the inline bump zrk-bench.sh used to do silently no-op'd whenever the login
  # session's hard limit was smaller — set it where it actually takes effect.
  # pam_limits governs LOGIN sessions only; systemd units inherit the manager's
  # limits and ignore this file entirely, which is why bench-suite.service below
  # restates LimitNOFILE/LimitMEMLOCK.
  - path: /etc/security/limits.d/99-bench.conf
    content: |
      ubuntu soft nofile 1048576
      ubuntu hard nofile 1048576
      ubuntu soft memlock unlimited
      ubuntu hard memlock unlimited

  # The contract's VM-side environment, in one file so the scripts below and the
  # systemd unit read the same thing. Nothing secret lives here.
  - path: /etc/bench/env
    content: |
      BENCH_BUCKET=${bench_bucket}
      BENCH_RUNID=${runid}
      BENCH_PROFILES=${bench_profiles}
      BENCH_PROXIES=${bench_proxies}
      PROXY_IP=${proxy_ip}
      BACKEND_IP=${backend_ip}
      SSH_KEY=${ssh_key_path}
      BENCH_ROLE=${role}
      # Not in the contract, which names only SSH_KEY — but remote.Ssh passes
      # UserKnownHostsFile explicitly, so it needs to be told where the pinned
      # file is. It is also in ssh's default location, so a bare `ssh` works too.
      BENCH_KNOWN_HOSTS=/home/ubuntu/.ssh/known_hosts

  # Object Storage over an IAM token minted by the metadata service — the whole
  # reason the instances carry a service account and no key file. Tokens are
  # short-lived and a run outlives one by a wide margin, so every call mints a
  # fresh one rather than caching. Yandex accepts the bearer token directly:
  # no SigV4, no access key, nothing to leak.
  - path: /usr/local/bin/bench-os
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      set -a; . /etc/bench/env; set +a
      base="https://storage.yandexcloud.net/$BENCH_BUCKET/runs/$BENCH_RUNID"
      tok=$(curl -sfS -H 'Metadata-Flavor: Google' \
        http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token \
        | python3 -c 'import json,sys; print(json.load(sys.stdin)["access_token"])')
      case "$1" in
        get) curl -sfS -H "Authorization: Bearer $tok" -o "$3" "$base/$2" ;;
        put) curl -sfS -X PUT -H "Authorization: Bearer $tok" --data-binary "@$3" "$base/$2" ;;
        say) printf '%s\n' "$3" | curl -sfS -X PUT -H "Authorization: Bearer $tok" --data-binary @- "$base/$2" ;;
        *)   echo "usage: bench-os get|put|say <object> <file|text>" >&2; exit 2 ;;
      esac

  # payload.tar is uploaded BEFORE apply, so it is already in the bucket when
  # this runs. The retry loop is for this end, not that one: the default route
  # through the NAT gateway and the instance's service-account binding both
  # become usable a few seconds after the guest starts running commands.
  - path: /usr/local/bin/bench-payload
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      install -d -o ubuntu -g ubuntu /home/ubuntu/bench
      for _ in $(seq 1 60); do
        if bench-os get payload.tar /tmp/payload.tar; then break; fi
        sleep 5
      done
      test -s /tmp/payload.tar
      tar -xf /tmp/payload.tar -C /home/ubuntu/bench
      chown -R ubuntu:ubuntu /home/ubuntu/bench
%{~ if role == "loadgen" }

  # The per-run ssh identity. It exists in exactly two places — terraform's
  # state in the CI workspace, and here — and both are gone when the job ends.
  # deferred, because write_files normally runs before the users module and
  # `owner: ubuntu` would not resolve yet; deferred writes still land before
  # runcmd, which is all this needs.
  - path: ${ssh_key_path}
    owner: "ubuntu:ubuntu"
    permissions: "0600"
    defer: true
    content: |
      ${indent(6, fleet_private_key)}

  # In the default location on purpose: anything that shells out to ssh picks it
  # up without being told, so peer verification does not depend on `bench`
  # passing the right -o flags.
  - path: /home/ubuntu/.ssh/known_hosts
    owner: "ubuntu:ubuntu"
    permissions: "0644"
    defer: true
    content: |
      ${indent(6, known_hosts)}

  # The run, end to end. Ordering here is the contract's: results.tar goes up
  # before DONE, so the runner never polls into a marker that points at a
  # half-uploaded object.
  - path: /usr/local/bin/bench-drive
    permissions: "0755"
    content: |
      #!/bin/bash
      set -uo pipefail
      set -a; . /etc/bench/env; set +a

      LOG=/home/ubuntu/bench.log
      # A terminal marker was written by THIS script. bench-postmortem checks it
      # so it only speaks when the script never got the chance to.
      TERMINAL=/run/bench-terminal
      exec > >(tee -a "$LOG") 2>&1

      fail() {
        echo "FAILED: $*"
        bench-os put log "$LOG" || true
        bench-os say FAILED "$*" || true
        : > "$TERMINAL" || true
        exit 1
      }

      # after fail() exists, so a payload that never landed is a FAILED marker
      # rather than a suite that quietly runs in the wrong directory
      cd /home/ubuntu/bench || fail "payload never unpacked into ~/bench"

      # the same pinning bench's remote.Ssh uses: the host keys came from
      # terraform, so there is no first use to trust
      peer() {
        timeout 900 ssh -i "$SSH_KEY" \
          -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=5 \
          -o StrictHostKeyChecking=yes -o UserKnownHostsFile="$BENCH_KNOWN_HOSTS" \
          "ubuntu@$1" "$2"
      }

      # sshd answers minutes before docker and the payload are in place, so gate
      # on the peer's own cloud-init and then on the two things actually needed.
      # `cloud-init status --wait` exits 2 for recoverable warnings, which is not
      # a reason to abandon a 40-minute run — hence the discarded status.
      wait_peer() {
        for _ in $(seq 1 120); do
          if peer "$1" 'cloud-init status --wait >/dev/null 2>&1; test -d ~/bench && docker info >/dev/null 2>&1'; then
            return 0
          fi
          sleep 10
        done
        return 1
      }

      wait_peer "$PROXY_IP" || fail "proxy never became ready"
      wait_peer "$BACKEND_IP" || fail "backend never became ready"

      # the contract's `log`: re-uploaded every ~30s so the runner can stream a
      # run it has no other way to watch.
      ( while sleep 30; do bench-os put log "$LOG" || true; done ) &
      tailer=$!
      trap 'kill $tailer 2>/dev/null || true' EXIT

      rc=0
      IFS=, read -r -a profiles <<< "$BENCH_PROFILES"
      for p in "$${profiles[@]}"; do
        ./bench suite --profile "$p" --proxies "$BENCH_PROXIES" || rc=$?
        # Ship what is finished after EVERY profile, not just at the end.
        #
        # results.tar used to be built once, after this loop, so a profile that
        # hung took the completed ones down with it: a c10k deadlock discarded a
        # c1k that had run clean for 51 minutes, and the run produced no
        # artifacts at all. The tar is cumulative (it archives the whole run
        # directory), so re-uploading it here just means the bucket always holds
        # everything finished so far.
        #
        # Deliberately NOT guarded by rc: a profile that failed still leaves
        # per-proxy records worth publishing, and `bench suite` already writes
        # profile.json after each proxy for the same reason.
        if [ -n "$(find results/"$BENCH_RUNID" -type f -print -quit 2>/dev/null)" ]; then
          tar -cf /tmp/results.tar -C results "$BENCH_RUNID" \
            && bench-os put results.tar /tmp/results.tar \
            || echo "warning: interim results.tar upload failed after $p" >&2
        fi
      done

      # An empty result is never useful, and `tar` succeeds on a directory tree
      # that contains nothing — which is exactly what a suite that aborted early
      # leaves behind. Without this check the runner sees DONE, fetches an empty
      # archive, and the failure surfaces two steps later as a confusing
      # FileNotFound from the report instead of as "the suite died".
      if [ -z "$(find results/"$BENCH_RUNID" -type f -print -quit 2>/dev/null)" ]; then
        fail "suite produced no artifacts (rc=$rc)"
      fi

      tar -cf /tmp/results.tar -C results "$BENCH_RUNID" || fail "suite produced no results/$BENCH_RUNID"
      bench-os put results.tar /tmp/results.tar || fail "results.tar upload failed"
      kill $tailer 2>/dev/null || true
      bench-os put log "$LOG" || true
      # rc 3 is `bench suite` reporting that it ran but some proxy failed — real
      # data worth publishing, with the per-proxy status recorded in
      # profile.json. Anything else means the suite itself broke.
      if [ "$rc" -eq 0 ] || [ "$rc" -eq 3 ]; then
        bench-os say DONE "rc=$rc"
        : > "$TERMINAL" || true
      else
        bench-os say FAILED "suite exited $rc"
        : > "$TERMINAL" || true
      fi
      exit $rc

  # A unit rather than a backgrounded runcmd, so the whole run lands in the
  # journal and can be pulled off a host that never reached DONE.
  # Speaks only when bench-drive did NOT — i.e. when it was killed rather than
  # finishing. Every terminal path in that script writes $TERMINAL after saying
  # DONE/FAILED, so an absent sentinel means it never reached its own reporting.
  #
  # This is the gap that hid the c10k memory leak for a whole day: the kernel
  # OOM-killed `bench` mid-ramp, and a SIGKILLed process writes no marker, no
  # watchdog line and no log. From the runner that is indistinguishable from a
  # hang, so `bench wait` polled a corpse until the step timed out, five runs
  # running. The evidence was on the serial console the entire time:
  #
  #     Out of memory: Killed process 5452 (bench) anon-rss:7664524kB
  #
  # Runs with `+`, i.e. as root regardless of User=ubuntu, because dmesg is
  # restricted and the whole point is to capture why the kernel intervened.
  - path: /usr/local/bin/bench-postmortem
    permissions: "0755"
    content: |
      #!/bin/bash
      set -uo pipefail
      set -a; . /etc/bench/env; set +a

      TERMINAL=/run/bench-terminal
      LOG=/home/ubuntu/bench.log
      [ -e "$TERMINAL" ] && exit 0

      {
        echo
        echo "=== bench-drive died without writing a terminal marker ==="
        echo "SERVICE_RESULT=$${SERVICE_RESULT:-?} EXIT_CODE=$${EXIT_CODE:-?} EXIT_STATUS=$${EXIT_STATUS:-?}"
        echo "--- memory at death ---"
        free -m 2>/dev/null
        echo "--- kernel OOM verdicts ---"
        dmesg 2>/dev/null | grep -iE "out of memory|oom-kill|killed process" | tail -5
        echo "--- unit journal, last 40 ---"
        journalctl -u bench-suite.service --no-pager -n 40 2>/dev/null
      } >> "$LOG" 2>&1

      bench-os put log "$LOG" || true
      bench-os say FAILED "bench-drive died: $${SERVICE_RESULT:-unknown} $${EXIT_STATUS:-}" || true
      : > "$TERMINAL" || true

  - path: /etc/systemd/system/bench-suite.service
    content: |
      [Unit]
      Description=zoxy-benchmark self-driving suite
      Requires=docker.service
      After=docker.service network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      User=ubuntu
      Group=ubuntu
      WorkingDirectory=/home/ubuntu/bench
      EnvironmentFile=/etc/bench/env
      ExecStart=/usr/local/bin/bench-drive
      # `+` runs it as root despite User=ubuntu: dmesg is restricted, and a
      # kernel OOM verdict is exactly what this needs to capture. Runs on EVERY
      # exit, and is a no-op unless bench-drive died without reporting.
      ExecStopPost=+/usr/local/bin/bench-postmortem
      # limits.d is pam_limits, which a unit never goes through: without these
      # two lines the c10k profile hits systemd's 1024 default and the run looks
      # like a proxy failure instead of a harness failure.
      LimitNOFILE=1048576
      LimitMEMLOCK=infinity
      TimeoutStartSec=infinity
%{~ endif }

apt:
  sources:
    docker:
      source: "deb [signed-by=$KEY_FILE] https://download.docker.com/linux/ubuntu $RELEASE stable"
      keyid: 9DC858229FC7DD38854AE2D88D81803C0EBFCD88

package_update: true

runcmd:
  - sysctl --system
  # pin docker-ce to the same major.minor everywhere (same compose CLI as local)
  - >-
    VERSION=$(apt-cache madison docker-ce | awk '$3 ~ /${docker_version}/ {print $3; exit}');
    apt-get install -y docker-ce=$VERSION docker-ce-cli=$VERSION containerd.io
    docker-buildx-plugin docker-compose-plugin
  - apt-mark hold docker-ce docker-ce-cli
  - systemctl enable --now docker
  - /usr/local/bin/bench-payload
  # One object per role (bench's ycs.Keys.bootOk, which exists so cloud-init and
  # the runner cannot disagree about a key). A single shared `boot-ok` would be
  # last-writer-wins and could not answer the only question it is ever asked:
  # which host failed to get here.
  - bench-os say boot-ok.${role} "${role} ready"
%{~ if role == "loadgen" }
  # a root-owned ~/.ssh is a failure that only shows up an hour later, as an
  # unexplained ssh error in the middle of a ramp
  - chown -R ubuntu:ubuntu /home/ubuntu/.ssh
  - chmod 700 /home/ubuntu/.ssh
  # --no-block: the suite runs for the better part of an hour, and cloud-init
  # has to be able to report "done" long before that — the peers' readiness gate
  # is exactly that signal, and blocking here would deadlock the fleet.
  - systemctl daemon-reload
  - systemctl start --no-block bench-suite.service
%{~ endif }
