# Copy to terraform.tfvars (gitignored). Laptop path only: CI passes -var
# runid=... and YC_* env from the OIDC exchange.

cloud_id  = "b1gxxxxxxxxxxxxxxxxx"
folder_id = "b1gxxxxxxxxxxxxxxxxx"
zone      = "ru-central1-a"

# Laptop runs only; CI uses YC_TOKEN.
service_account_key_file = "sa-key.json" # yc iam key create ... --output sa-key.json

# Lowercase [a-z0-9-]; it becomes an instance label AND a resource-name suffix.
runid = "manual-20260728"

# Pre-existing, outlive any run. The SA needs write access to the bucket only.
service_account_id = "ajexxxxxxxxxxxxxxxxx"
bench_bucket       = "zoxy-benchmark"

# bench_profiles = "c1k,c10k"
# bench_proxies  = "zoxy,haproxy,nginx,pingora,envoy"

# sizing defaults: see variables.tf

# No ssh_public_key: terraform generates the keypair. Use the serial console.
