# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# CI does NOT use this file: the nightly workflow passes -var runid=... and
# exports YC_TOKEN / YC_CLOUD_ID / YC_FOLDER_ID from the OIDC exchange. This is
# the laptop path — same fleet, same self-driving run, one human holding a key.

cloud_id  = "b1gxxxxxxxxxxxxxxxxx"
folder_id = "b1gxxxxxxxxxxxxxxxxx"
zone      = "ru-central1-a"

# Only for a laptop run. Leave unset in CI and let YC_TOKEN do it.
service_account_key_file = "sa-key.json" # yc iam key create ... --output sa-key.json

# Lowercase [a-z0-9-]; it becomes an instance label AND a resource-name suffix.
runid = "manual-20260728"

# Pre-existing, and outlives any single run: the instances' identity, and the
# bucket they read payload.tar from and write results.tar/DONE back to.
# The SA needs write access to the bucket and nothing else.
service_account_id = "ajexxxxxxxxxxxxxxxxx"
bench_bucket       = "zoxy-benchmark"

# bench_profiles = "c1k,c10k"
# bench_proxies  = "direct,zoxy,haproxy,pingora,envoy"  # traefik/nginx were deleted, not parked

# proxy 2c/4g, backend 4c/8g, loadgen 4c/8g by default — see variables.tf

# There is no ssh_public_key: the run's keypair is generated by terraform and
# only the loadgen ever holds the private half. Nothing outside the VPC can
# reach the fleet, so there is nothing for your own key to open — use the
# serial console (serial-port-enable) if a host needs looking at.
